{
  "name": "reviewhopper",
  "description": "Ouvre dans l'éditeur local le fichier et la ligne d'une review GitHub (diff de PR, commit, commentaires).",
  "version": "1.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:store": "REVIEWHOPPER_STORE=1 wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "screenshots": "node scripts/screenshots/run.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wxt": "^0.21.5"
  }
}
